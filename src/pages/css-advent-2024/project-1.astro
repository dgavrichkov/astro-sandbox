---
const BASE_IMG_URL = "/images/css-advent-day1";

const galleries = [
  {
    title: "Gallery 1",
    images: [
      `${BASE_IMG_URL}/image-1.jpg`,
      `${BASE_IMG_URL}/image-2.jpg`,
      `${BASE_IMG_URL}/image-3.jpg`,
      `${BASE_IMG_URL}/image-4.jpg`,
      `${BASE_IMG_URL}/image-5.jpg`,
      `${BASE_IMG_URL}/image-exra.jpg`,
    ],
  },
  {
    title: "Gallery 2",
    images: [
      `${BASE_IMG_URL}/image-1.jpg`,
      `${BASE_IMG_URL}/image-2.jpg`,
      `${BASE_IMG_URL}/image-3.jpg`,
      `${BASE_IMG_URL}/image-4.jpg`,
      `${BASE_IMG_URL}/image-5.jpg`,
    ],
  },
  {
    title: "Gallery 3",
    images: [
      `${BASE_IMG_URL}/image-1.jpg`,
      `${BASE_IMG_URL}/image-2.jpg`,
      `${BASE_IMG_URL}/image-3.jpg`,
      `${BASE_IMG_URL}/image-4.jpg`,
    ],
  },
  {
    title: "Gallery 4",
    images: [
      `${BASE_IMG_URL}/image-1.jpg`,
      `${BASE_IMG_URL}/image-2.jpg`,
      `${BASE_IMG_URL}/image-3.jpg`,
    ],
  },
  {
    title: "Gallery 5",
    images: [`${BASE_IMG_URL}/image-1.jpg`, `${BASE_IMG_URL}/image-2.jpg`],
  },
  {
    title: "Gallery 6",
    images: [`${BASE_IMG_URL}/image-1.jpg`],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CSS Grid Gallery</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div>
      <h1>CSS Grid Gallery</h1>
      <a href="/">go home</a>
    </div>
    <main class="container">
      {
        galleries.map((gallery) => (
          <section class="gallery-section">
            <h2>{gallery.title}</h2>
            <ul class="gallery">
              {gallery.images.map((image, imgIndex) => (
                <li class="card">
                  <img src={image} alt={`Image ${imgIndex + 1}`} width="300" />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>
  </body>
</html>

<style>
  body {
    font-family: Helvetica, sans-serif;
  }
  .gallery-section {
    margin: 0 auto;
    margin-bottom: 24px;
    width: 560px;
    padding: 16px 14px;
  }

  .gallery {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 158px 158px;
    gap: 12px;
  }

  .card {
    border-radius: 6px;
    overflow: hidden;

    grid-column: span 6;
    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* для двух и менее карточек - растягиваем их на обе строки */
  .card:nth-last-child(-n + 2):first-child,
  .card:nth-last-child(-n + 2):first-child ~ .card {
    grid-row: span 2;
  }

  /* 2 columns */
  .card:nth-last-child(n + 2):first-child,
  .card:nth-last-child(n + 2):first-child ~ .card {
    &:nth-child(1) {
      grid-column: span 3;
    }
    &:nth-child(2) {
      grid-column: span 3;
    }
  }

  /* 3 columns */
  .card:nth-last-child(n + 3):first-child,
  .card:nth-last-child(n + 3):first-child ~ .card {
    &:nth-child(1) {
      grid-column: span 3;
    }
    &:nth-child(2) {
      grid-column: span 3;
    }
    &:nth-child(3) {
      grid-column: span 6;
    }
  }

  /* 4 columns */
  .card:nth-last-child(n + 4):first-child,
  .card:nth-last-child(n + 4):first-child ~ .card {
    &:nth-child(1) {
      grid-column: span 3;
    }
    &:nth-child(2) {
      grid-column: span 3;
    }
    &:nth-child(3) {
      grid-column: span 3;
    }
    &:nth-child(4) {
      grid-column: span 3;
    }
  }

  /* 5 columns */
  .card:nth-last-child(n + 5):first-child,
  .card:nth-last-child(n + 5):first-child ~ .card {
    &:nth-child(1) {
      grid-column: span 3;
    }
    &:nth-child(2) {
      grid-column: span 3;
    }
    &:nth-child(3) {
      grid-column: span 2;
    }
    &:nth-child(4) {
      grid-column: span 2;
    }
    &:nth-child(5) {
      grid-column: span 2;
    }
  }

  /* более шести - на пятом рисуем маркер, остальные будут спрятаны*/
  .card:nth-last-child(n + 6):first-child,
  .card:nth-last-child(n + 6):first-child ~ .card {
    &:nth-child(5) {
      position: relative;

      &::after {
        content: "+1";
        position: absolute;
        top: 50%;
        left: 50%;
        color: white;
        font-size: 48px;
        font-weight: bold;
        transform: translate(-50%, -50%);
        text-align: center;
      }
    }
  }

  .card:nth-child(n + 6) {
    display: none;
  }
</style>

---
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header class="header">
  <div class="header__main">
    <ThemeIcon />
    <Navigation />
  </div>
</header>

<style>
  .header {
    padding: 10px 0;
    border-bottom: 1px solid #ccc;
  }

  .header__main {
    display: flex;
    gap: 14px;
  }
</style>

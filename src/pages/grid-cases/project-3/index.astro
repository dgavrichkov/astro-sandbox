---
// import "../../../shared/reset.css";
import "./style.css";

const BASE_IMG_URL = "/images/grid-project-3";

const catalog = [
  {
    id: "1",
    name: "Букет «Весна»",
    price: 1500,
    img: "photo",
  },
  {
    id: "2",
    name: "Букет «Признание»",
    price: 1500,
    img: "photo",
  },
  {
    id: "3",
    name: "Букет «Сюрприз»",
    price: 1500,
    img: "photo",
  },
  {
    id: "4",
    name: "Букет «Апрель»",
    price: 1500,
    img: "photo",
  },
  {
    id: "5",
    name: "Букет «Сухоцветы»",
    price: 1500,
    img: "photo",
  },
  {
    id: "6",
    name: "Букет «Нежность»",
    price: 1500,
    img: "photo",
  },
  {
    id: "7",
    name: "Букет «Яркость»",
    price: 1500,
    img: "photo",
  },
  {
    id: "8",
    name: "Букет «Любовь»",
    price: 1500,
    img: "photo",
  },
  {
    id: "9",
    name: "Букет «Ласка»",
    price: 1500,
    img: "photo",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grid: Floral Boutique</title>
  </head>
  <body>
    <section class="catalog">
      <h2 class="visually-hidden">Каталог товаров</h2>
      <ul class="catalog__list">
        {
          catalog.map((item) => (
            <li class="catalog__item">
              <article class="card">
                <figure>
                  <img
                    alt="изображение букета"
                    src={`${BASE_IMG_URL}/${item.img}.webp`}
                    width="300"
                    height="280"
                  />
                </figure>

                <h3 class="card__title">{item.name}</h3>
                <p>{item.price} ₽</p>
                <button class="card-button">Заказать</button>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </body>
</html>

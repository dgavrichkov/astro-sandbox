---
// https://htmlacademy.ru/demos/225#1
// Эффект сияния
---

<section>
  <div class="card">
    <div class="card-header">
      <div>artifact</div>
    </div>
    <div class="card-content">
      <h1>Implosion<br />Tier V<br /> Spell</h1>
      <p>A force from the deep — silent, radiant, and absolute.</p>
      <div class="shader">
        <img src="./images/implosion.webp" width="600" alt="Implosion" />
        <div class="shader__layer specular">
          <div class="shader__layer mask"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --implosion-timing-function: linear(
      0 0%,
      0 3%,
      0.02 0.01 12%,
      0.03 18%,
      0.04 24%,
      0.05 30%,
      0.6 70%,
      1 100%
    );
    --implosion-time: 5s;
  }

  @keyframes pulse {
    to {
      --radius: 600px;
    }
  }

  @keyframes pulse-gradient {
    0% {
      background-size: 100% 100%;
    }
    100% {
      background-size: 400% 400%;
    }
  }

  @property --radius {
    inherits: false;
    initial-value: 0px;
    syntax: "<length>";
  }

  section {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    margin: 0;
    color: white;
    font-family: "Arial", sans-serif;
    background: #f8f8f8;
  }

  .card {
    position: relative;
    width: 460px;
    padding: 20px;
    padding-right: 100px;
    color: white;
    text-align: left;
    background-color: #333;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    box-sizing: content-box;

    overflow: hidden;
  }

  .card-header {
    padding-left: 10px;
    padding-top: 10px;
    font-size: 20px;
    font-weight: bold;
    text-align: left;
    text-transform: lowercase;
  }

  .card-content {
    padding: 20px;
    padding-top: 40px;
  }

  .card-content h1 {
    margin: 0;
    margin-bottom: 50px;
    font-family: "Impact", sans-serif;
    font-size: 60px;
    line-height: 1.1;
    font-weight: 700;
    text-transform: uppercase;
    color: #2196f3;
  }

  .card-content h1 {
    background-image: radial-gradient(
      circle farthest-side at 100% 100%,
      #ffe135 35%,
      #d4a017 35.1%,
      #d4a017 48%,
      #555555 48.1%,
      #393939 100%
    );
    background-position: bottom right;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: pulse-gradient var(--implosion-time)
      var(--implosion-timing-function) infinite alternate;
  }

  .card-content p {
    max-width: 200px;
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.3;
    opacity: 0.5;
  }

  .card img {
    display: initial;
    max-width: initial;
  }

  .shader {
    position: absolute;
    bottom: -200px;
    right: -230px;
    width: 600px;
    height: 600px;
    /* CSS-свойство backface-visibility: hidden помогает оптимизировать производительность этого эффекта. */
    backface-visibility: hidden;
  }

  .shader img {
    width: 600px;
  }

  .shader__layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    background-color: black;
  }

  .mask {
    background-image: url("./images/implosion.webp");
    background-size: 600px auto;
    /* В основе голографического эффекта лежит свойство mix-blend-mode, которое управляет тем, как элемент визуально смешивается с фоном под ним. */
    /* Значение multiply помогает «обрезать» будущую голограмму по границам фонового изображения. Именно поэтому блок называется маской. */
    mix-blend-mode: multiply;
    /* приведёт к тому, что градиентный фон будет обрезан точно по границам изображения, а за границами будет виден чёрный цвет. */
    background-color: black;
  }

  .specular {
    --radius: 0px;

    background-image: radial-gradient(
      circle var(--radius) at 51% 50%,
      transparent,
      #ffd700,
      transparent
    );
    /* Значение color-dodge является режимом наложения, который усиливает светлые области. Если верхний цвет полностью чёрный, то цвет под ним остаётся без изменений. Если же верхний цвет светлее, то он осветляет цвет, находящийся под ним. */
    mix-blend-mode: color-dodge;

    animation: pulse var(--implosion-time) infinite
      var(--implosion-timing-function) alternate;
  }
</style>
